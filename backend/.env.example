# Copy this file to .env and fill in real values. Never commit the real .env file.

ENV=development

# Supabase (Phase: Database)
SUPABASE_URL=
SUPABASE_KEY=

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Evidence Fusion / Investigation thresholds
EVIDENCE_INSUFFICIENT_THRESHOLD=0.55
EVIDENCE_HIGH_CONFIDENCE_THRESHOLD=0.80
